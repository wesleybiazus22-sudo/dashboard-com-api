# ============================================================
# Banco de dados (Postgres / Supabase)
# ============================================================
# Pegue essa string em: Supabase > Project Settings > Database > Connection String (URI)
DATABASE_URL=postgresql+psycopg2://postgres:SUA_SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ============================================================
# RD Station CRM - App OAuth
# ============================================================
# Crie o app em: RD Station CRM > Configurações > Integrações > Central de Apps > Criar aplicativo
RD_CRM_CLIENT_ID=seu_client_id_aqui
RD_CRM_CLIENT_SECRET=seu_client_secret_aqui

# Precisa ser IDÊNTICA à cadastrada no app do RD Station (use https, mesmo em dev via ngrok/tunnel)
RD_CRM_REDIRECT_URI=https://SEU_DOMINIO/auth/rd/callback

# Endpoints OAuth do RD Station (unificados entre Marketing e CRM v2).
# Confirme contra a documentação atual antes do primeiro uso:
# https://developers.rdstation.com/reference/autenticacao-crm
RD_AUTH_DIALOG_URL=https://accounts.rdstation.com/oauth/authorize
RD_TOKEN_URL=https://api.rd.services/oauth2/token
RD_CRM_API_BASE_URL=https://api.rd.services/crm/v2

# ============================================================
# Webhook
# ============================================================
# Token simples que você mesmo escolhe e cadastra na URL do webhook no RD,
# ex: https://SEU_DOMINIO/webhooks/rd?token=XXXX  -> usado para validar a origem
RD_WEBHOOK_TOKEN=escolha-um-token-aleatorio-forte

# ============================================================
# Sincronizacao agendada (GitHub Actions -> /sync/rd/incremental)
# ============================================================
# Outro token aleatorio forte, protege os endpoints /sync/rd/* de serem
# chamados por qualquer um que descubra a URL publica.
SYNC_TRIGGER_TOKEN=escolha-outro-token-aleatorio-forte

# ============================================================
# Meta Ads (Facebook/Instagram) - Marketing API
# ============================================================
# Crie o app em: developers.facebook.com/apps > Criar app > tipo "Empresa" >
# Adicionar produtos > Marketing API. App ID e App Secret ficam em
# Configuracoes > Basico.
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui

# Token de um USUARIO DO SISTEMA (nao de usuario comum) com permissao ads_read
# e expiracao "Nunca" -- gerado em business.facebook.com/settings > Usuarios
# do sistema. Token de usuario comum expira em 60 dias e quebraria o sync
# automatico de 15 em 15 min sem renovacao manual.
META_ACCESS_TOKEN=seu_token_de_sistema_aqui

# Formato "act_XXXXXXXXXXX" (com o prefixo act_), visivel no Gerenciador de
# Anuncios ou na URL ao abrir a conta.
META_AD_ACCOUNT_ID=act_00000000000

# Versao da Graph API usada nas chamadas -- atualize periodicamente conforme
# o cronograma de deprecacao do Meta (https://developers.facebook.com/docs/graph-api/changelog).
META_API_VERSION=v21.0

# ============================================================
# App
# ============================================================
ENV=development
LOG_LEVEL=INFO
