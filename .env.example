# ============================================================
# Banco de dados (Postgres / Supabase)
# ============================================================
# Pegue essa string em: Supabase > Project Settings > Database > Connection String (URI)
DATABASE_URL=postgresql+psycopg2://postgres:SUA_SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ============================================================
# RD Station CRM - App OAuth
# ============================================================
# Crie o app em: RD Station CRM > Configurações > Integrações > Central de Apps > Criar aplicativo
RD_CRM_CLIENT_ID=seu_client_id_aqui
RD_CRM_CLIENT_SECRET=seu_client_secret_aqui

# Precisa ser IDÊNTICA à cadastrada no app do RD Station (use https, mesmo em dev via ngrok/tunnel)
RD_CRM_REDIRECT_URI=https://SEU_DOMINIO/auth/rd/callback

# Endpoints OAuth do RD Station (unificados entre Marketing e CRM v2).
# Confirme contra a documentação atual antes do primeiro uso:
# https://developers.rdstation.com/reference/autenticacao-crm
RD_AUTH_DIALOG_URL=https://accounts.rdstation.com/oauth/authorize
RD_TOKEN_URL=https://api.rd.services/oauth2/token
RD_CRM_API_BASE_URL=https://api.rd.services/crm/v2

# ============================================================
# Webhook
# ============================================================
# Token simples que você mesmo escolhe e cadastra na URL do webhook no RD,
# ex: https://SEU_DOMINIO/webhooks/rd?token=XXXX  -> usado para validar a origem
RD_WEBHOOK_TOKEN=escolha-um-token-aleatorio-forte

# ============================================================
# App
# ============================================================
ENV=development
LOG_LEVEL=INFO
